# Copy this file to .env and fill in the first line. Nothing else is required.

# The password you sign in with (user name: owner). At least 20 characters.
# It also protects your saved keys: they are encrypted with it, so keep it the same.
HQ_ACCESS_PASSWORD=

# Where the app listens. The defaults suit running it on your own computer.
#HOST=127.0.0.1
#PORT=3000

# Only when you put the app on a server under a domain: its public address.
#HQ_PUBLIC_ORIGIN=https://jobs.example.com

# Where your data lives. Defaults to the data folder next to the app.
#HQ_DATA_DIR=./data
